# Copy to .env.local and fill in. `.env.local` is gitignored; this file is not.
#
# Named `env.example` rather than `.env.local.example` on purpose: .gitignore ignores
# `.env*`, so any name starting with a dot cannot be committed and the copy-this-file
# instruction in the README silently referred to a file that was never in the repo.

# ── Database ──────────────────────────────────────────────────────────────────
# Read by lib/db.ts, which throws at import if it is unset — the app will not boot
# without it. node-pg-migrate reads it too (npm run migrate:up).
# Needs the pgvector extension available; see db/schema.sql.
DATABASE_URL=postgresql://localhost:5432/b8_finance

# Used only by docker compose, for the `db` container's superuser password. The
# DATABASE_URL above is overridden inside compose to point at the `db` service.
POSTGRES_PASSWORD=

# ── Plaid ─────────────────────────────────────────────────────────────────────
# Read by lib/plaid.ts, which throws at import if the id/secret are unset.
# PLAID_ENV is one of sandbox | production, and defaults to sandbox.
# Do not set production until the release gate in docs/ has been met — production
# credentials reach real bank accounts.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Encrypts Plaid access tokens at rest (lib/crypto.ts). 32 bytes, base64:
#   openssl rand -base64 32
#
# Required to link or sync a Plaid connection. Keep it OUT of the database and out of
# backups of the database — holding both in one place defeats the point, which is that a
# dump or a stolen backup alone yields nothing usable.
#
# If this is lost, stored tokens are unrecoverable and every institution must be re-linked
# through Plaid Link. Transaction history survives (it is keyed on accounts, not on the
# credential); the connections do not.
TOKEN_ENCRYPTION_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Read by app/api/chat/route.ts. Optional: without it the app runs and only the
# chat assistant returns a 500.
ANTHROPIC_API_KEY=

# ── Authentication ────────────────────────────────────────────────────────────
# Cloudflare Access. Set BOTH or NEITHER — half-configured is a startup error, because it
# would read like protection while providing none.
#
# CF_ACCESS_TEAM_DOMAIN is the subdomain part only: for
# https://yourteam.cloudflareaccess.com, it is `yourteam`.
# CF_ACCESS_AUD is the Application Audience (AUD) tag from the Access application for THIS
# hostname. It is what stops a token minted for another app behind the same Cloudflare
# account being replayed here — every Access application is signed with the same team keys.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# The first user. If the users table is empty and this address presents a verified
# assertion, its row is created on first sign-in. It stops having any effect the moment a
# user exists, so leaving it set is harmless. Add anyone else with:
#   npm run add-user -- them@example.com "Their Name"
BOOTSTRAP_ADMIN_EMAIL=

# Set to exactly 1 to skip authentication entirely, for local development. Refuses to start
# when NODE_ENV=production.
AUTH_DEV_BYPASS=

# ── Backups ───────────────────────────────────────────────────────────────────
# Encrypts backup archives (scripts/backup.sh). Any strong passphrase; the script refuses
# to run without one rather than writing an unencrypted dump of your finances.
#
# Store it separately from TOKEN_ENCRYPTION_KEY and from the backups themselves — a restore
# needs both secrets, and keeping them together re-creates the single point of failure.
BACKUP_PASSPHRASE=

# How many archives to keep (default 14). Pruning happens only after a new archive is
# confirmed good, so a failing backup can never delete the last working one.
BACKUP_RETAIN=14

# ── Networking ────────────────────────────────────────────────────────────────
# Comma-separated extra Host header values accepted by lib/hostGuard.ts, on top of
# the always-allowed loopback names. Leave empty for local-only use.
#
# Set this to the public hostname when serving through a reverse proxy or a
# Cloudflare Tunnel, which forwards the original public Host — without it every
# proxied request is rejected with 403.
#
# Naming a non-loopback host here while CF_ACCESS_* above are unset is a STARTUP ERROR, not
# a warning. Being reachable and being authenticated are one decision: the alternative is
# adding a hostname, forgetting the identity variables, and silently publishing an app full
# of bank data with no login.
#
# ALLOWED_HOSTS=finance.example.com
ALLOWED_HOSTS=
